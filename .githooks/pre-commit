#!/bin/bash
# Blocks commits that contain API keys or secret files. Never bypass with --no-verify.
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$(basename "$f")" in
    .env|.env.*|*.pem|*.key|keys.env|credentials*.json|client_secret*.json)
      [ "$(basename "$f")" = ".env.example" ] || { echo "BLOCKED: secret file staged: $f"; fail=1; } ;;
  esac
done
pat='(AIza[0-9A-Za-z_-]{35}|eyJhbGciOi[0-9A-Za-z_.-]{20,}|sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|(api[_-]?key|token|secret|password)["'"'"' ]*[:=] *["'"'"']?[A-Za-z0-9_-]{16,})'
hits=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++' | grep -iE "$pat")
if [ -n "$hits" ]; then echo "BLOCKED: possible API key in staged changes:"; echo "$hits" | cut -c1-80 | sed -E 's/([A-Za-z0-9_-]{6})[A-Za-z0-9_-]{10,}/\1…[redacted]/g'; fail=1; fi
[ $fail = 0 ] || { echo "Move secrets to .env (gitignored) and unstage them."; exit 1; }
